# Reader (answers every question) and judge (buckets every answer)
OPENAI_API_KEY=
DOC_PROCESSING_MODEL=gpt-6-luna
DOC_PROCESSING_JUDGE_MODEL=gpt-6-sol
# GPT-6 is served on the native OpenAI API. Set to openai to use it even when
# the Azure variables below are present.
DOC_PROCESSING_LLM_PROVIDER=openai

# Optional OpenAI-compatible Azure deployment for the reader/judge
AZURE_OPENAI_NEXTGEN_DEPLOYMENT_URL=
AZURE_OPENAI_NEXTGEN_DEPLOYMENT_KEY=

# Parser providers (only required for the arms you run)
LLAMA_API_KEY=
REDUCTO_API_KEY=
EXTEND_API_KEY=
PULSE_API_KEY=
MISTRAL_API_KEY=
DATALAB_API_KEY=
UNSTRUCTURED_API_KEY=

# Claude Fable parser arm through Amazon Bedrock
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
